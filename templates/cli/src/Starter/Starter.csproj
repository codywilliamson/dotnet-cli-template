<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>starter</AssemblyName>
    <PublishAot>true</PublishAot>
    <!-- PublishAot adds a host-RID ILCompiler pack, so the lock file would differ per OS -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\skills\starter\SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="XenoAtom.CommandLine" />
    <PackageReference Include="XenoAtom.Terminal" />
    <PackageReference Include="XenoAtom.Terminal.UI" />
<!--#if (mcp)-->
    <PackageReference Include="ModelContextProtocol.Core" />
<!--#endif-->
  </ItemGroup>
</Project>
